# Soroban testnet RPC endpoint
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (testnet shown; must match the network Freighter is set to)
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed ProofPay contract IDs -- see docs/deployment/testnet.md for the real
# addresses this repo's own testnet deployment uses.
VITE_TOKEN_CONTRACT_ID=
VITE_VERIFIER_CONTRACT_ID=
VITE_THRESHOLD_VERIFIER_CONTRACT_ID=
VITE_AUDITOR_CONTRACT_ID=

# Analytics & monitoring (optional -- app runs without these, just without
# tracking/error-reporting). See README for what's tracked and why.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
